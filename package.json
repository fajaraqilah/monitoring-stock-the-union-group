{
  "name": "inventory-management-system",
  "version": "1.0.0",
  "description": "A multi-page inventory management system with Supabase integration",
  "main": "index.html",
  "scripts": {
    "start": "serve .",
    "build": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "dev": "concurrently \"tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch\" \"serve .\""
  },
  "keywords": [
    "inventory",
    "management",
    "supabase",
    "javascript",
    "tailwind",
    "chartjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "chart.js": "^4.4.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "serve": "^14.2.1",
    "tailwindcss": "^3.4.1"
  }
}